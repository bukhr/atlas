# ============================================================
# Google OAuth (obligatorio)
# Crear OAuth client tipo "Web application" en
# https://console.cloud.google.com → APIs & Services → Credentials
# ============================================================
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# Drive (obligatorio)
# ID de la carpeta raíz que se mostrará como tope del árbol.
# Se obtiene de la URL de la carpeta en drive.google.com
# ============================================================
VITE_ROOT_FOLDER_ID=

# ============================================================
# App (obligatorio en producción)
# ============================================================
PUBLIC_APP_URL=http://localhost:3000
# Generar con: openssl rand -base64 32
JWT_SECRET=

# ============================================================
# Server (opcional)
# ============================================================
PORT=3000

# ============================================================
# Storage (opcional, default: filesystem)
# ============================================================
STORAGE_DRIVER=filesystem
STORAGE_PATH=./data
# Solo si STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# CLOUDFRONT_DISTRIBUTION_ID=

# ============================================================
# Branding (opcional)
# ============================================================
PUBLIC_APP_NAME=Atlas
PUBLIC_CONTACT_EMAIL=
PUBLIC_PRIVACY_POLICY_URL=

# ============================================================
# Analytics (opcional)
# ============================================================
VITE_GA_MEASUREMENT_ID=
