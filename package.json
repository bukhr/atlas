{
	"name": "atlas",
	"description": "Hierarchical viewer for Google Drive shared folders",
	"version": "0.0.1",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bukhr/atlas.git"
	},
	"scripts": {
		"dev": "npm run build:extension && vite dev",
		"build": "npm run build:extension && vite build && npm run build:server",
		"build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --outfile=dist/server.js --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
		"build:extension": "node scripts/build-extension.mjs",
		"start": "node dist/server.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || true; if [ -f scripts/build-extension.mjs ]; then node scripts/build-extension.mjs; fi",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@internationalized/date": "^3.10.1",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.0.15",
		"esbuild": "^0.27.7",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"jose": "^6.2.2",
		"playwright": "^1.57.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6",
		"vitest": "^4.0.15",
		"vitest-browser-svelte": "^2.0.1"
	},
	"dependencies": {
		"@aws-sdk/client-cloudfront": "^3.1045.0",
		"@aws-sdk/client-s3": "^3.1045.0",
		"@hono/node-server": "^2.0.1",
		"@humanspeak/svelte-virtual-list": "^0.3.6",
		"@skeletonlabs/skeleton": "^4.10.0",
		"@skeletonlabs/skeleton-svelte": "^4.11.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"clsx": "^2.1.1",
		"hono": "^4.12.18",
		"localforage": "^1.10.0",
		"lucide-svelte": "^0.562.0",
		"svelte-virtual-scroll-list": "^1.3.0",
		"tailwind-merge": "^3.4.0"
	}
}
